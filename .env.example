# Copy to .env or .env.local (both gitignored) and adjust as needed.

# Treat the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io)
# as unavailable, so local dev boots straight onto the default character.
VITE_DEV_MODE=false

# Fart Power the player starts with (falls back to 20 if unset or invalid).
VITE_START_FART_POWER=20

# Cash the player starts with (falls back to 0 if unset or invalid).
VITE_START_CASH=0

# Multiplayer server (Fart-to-break-doors-backend). DEV is used by `npm run dev`
# (falls back to a local server on ws://localhost:2567); MAIN is used by
# production builds. Leave MAIN empty until the backend is deployed — the game
# then just plays solo.
VITE_SERVER_URL_DEV=ws://localhost:2567
VITE_SERVER_URL_MAIN=
